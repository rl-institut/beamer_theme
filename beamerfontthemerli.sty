\mode<presentation>

\setbeamerfont{normal text}{size=\Huge}
\setbeamerfont{title}{size=\LARGE}
\setbeamerfont{frametitle}{size=\LARGE,series=\bfseries}
\setbeamerfont{itemize/enumerate item}{size=\small,series=\mdseries}
\setbeamerfont{itemize/enumerate subitem}{size=\small,series=\mdseries}
\setbeamerfont{itemize/enumerate subsubitem}{size=\footnotesize,series=\mdseries}
\setbeamerfont{itemize/enumerate body}{size=\large,series=\mdseries}
\setbeamerfont{itemize/enumerate subbody}{size=\normalsize,series=\mdseries}
\setbeamerfont{itemize/enumerate subsubbody}{size=\small,series=\mdseries}
\setbeamerfont{description body}{size=\large,series=\mdseries}
\setbeamerfont{description item}{size=\Large,series=\bfseries}

% House font (CD 2025): Nunito Sans. Requires the font installed on the system
% (Regular/Bold/Italic/BoldItalic + ExtraBold for headings). Loaded via fontspec,
% so building requires XeLaTeX (or LuaLaTeX). Do NOT use the pdfLaTeX-only nunito.sty.
\setsansfont{Nunito Sans}

% ExtraBold family for headings (title page + frame titles)
\newfontfamily\rliheadingfont{Nunito Sans ExtraBold}

\usebeamerfont{normal text}
\mode
<all>