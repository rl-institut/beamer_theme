\mode<presentation>

% Define colors (Corporate Design 2025)
\definecolor{rliblue}{HTML}{002E4F}   % primary
\definecolor{rligray}{HTML}{A5A6A6}   % primary
\definecolor{rligraylight}{HTML}{ECECEC}
\definecolor{rligreen}{HTML}{00E47C}  % CD accent, available for highlights (not applied by default)
% Secondary print accent (CMYK C70 M0 Y65 K0) available if needed:
% \definecolor{rligreencmyk}{cmyk}{0.7,0,0.65,0}
\definecolor{rlilinkcolor}{HTML}{002E4F}  % readable link color (accent green fails contrast on white)

% Set colors
\setbeamercolor{title}{fg=rliblue}
\setbeamercolor{frametitle}{fg=rliblue}
\setbeamercolor{normal text}{fg=black}
\setbeamercolor{alerted text}{fg=rligray}
\setbeamercolor{section in head/foot}{bg=rliblue}
\setbeamercolor{author in head/foot}{bg=rliblue}
\setbeamercolor{date in head/foot}{fg=rliblue}

\setbeamercolor*{title page}{fg=rliblue}
\setbeamercolor*{title in head/foot}{fg=rliblue,bg=rligraylight}
\setbeamercolor*{author}{fg=rliblue}
\setbeamercolor*{date}{fg=rliblue}
\setbeamercolor{enumerate item}{fg=rliblue}
\setbeamercolor{enumerate subitem}{fg=rliblue}
\setbeamercolor{description body}{fg=rliblue}
\setbeamercolor{itemize body}{fg=rliblue}
\setbeamercolor{enumerate body}{fg=rliblue}
\setbeamercolor{structure}{fg=rliblue}

\mode
<all>
